        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.EduPulse.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Theme.EduPulse" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/cyan_neon</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">@color/cyan_glow</item>
        <item name="colorOnPrimaryContainer">@color/cyan_neon</item>

        <item name="colorSecondary">@color/blue_electric</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>

        
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.EduPulse.Headline</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.EduPulse.Body</item>
    </style>
    <style name="Widget.EduPulse.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card_translucent</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/border_card</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.EduPulse.NeonButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_neon_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
