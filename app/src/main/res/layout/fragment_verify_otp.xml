<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_dark_cyber_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- Top Bar -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EduPulse"
            android:textColor="@color/cyan_neon"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/language_en"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHelp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_help"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_container_glow"
                android:padding="6dp"
                android:src="@drawable/ic_user"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Center Shield Icon -->
        <FrameLayout
            android:id="@+id/iconShield"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_icon_container_glow"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_lock"
                app:tint="@color/cyan_neon" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvVerifyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/verify_identity_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iconShield"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvVerifySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/verify_identity_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvVerifyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Masked Email Chip -->
        <LinearLayout
            android:id="@+id/chipMaskedEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintTop_toBottomOf="@id/tvVerifySubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_mail"
                app:tint="@color/cyan_neon" />

            <TextView
                android:id="@+id/tvMaskedEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/demo_masked_email"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChangeEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/change_email_phone"
            android:textColor="@color/text_link"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/chipMaskedEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Security Code Header Row -->
        <RelativeLayout
            android:id="@+id/rowSecurityCodeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:layout_constraintTop_toBottomOf="@id/tvChangeEmail">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="6dp"
                android:text="@string/security_code_title"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableTint="@color/cyan_neon" />

            <TextView
                android:id="@+id/badgeAutoFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_verified"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/auto_fill_active"
                android:textColor="@color/success_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 6-Digit OTP Boxes Row -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/rowSecurityCodeLabel">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_otp_box_selector"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:text="4"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_otp_box_selector"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:text="8"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_otp_box_selector"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:text="2"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_otp_box_selector"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:text="9"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_otp_box_focused"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:text="1"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_otp_box_default"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/cyan_neon"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tap boxes instructions -->
        <TextView
            android:id="@+id/tvOtpHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/otp_instructions"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/otpContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Expired Pill / Timer -->
        <TextView
            android:id="@+id/pillTimerExpired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/code_expired_pill"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tvOtpHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Resend Code -->
        <LinearLayout
            android:id="@+id/rowResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/pillTimerExpired"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/didnt_receive_code"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resend_otp_link"
                android:textColor="@color/cyan_neon"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Verify & Activate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyActivate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_neon_button_selector"
            app:backgroundTint="@null"
            android:text="@string/btn_verify_activate"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/rowResendOtp" />

        <!-- Faculty Helpdesk & Alternate Method -->
        <RelativeLayout
            android:id="@+id/rowHelpdesk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@id/btnVerifyActivate">

            <TextView
                android:id="@+id/tvContactHelpdesk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_faculty_helpdesk"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTryAlternate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/try_alternate_method"
                android:textColor="@color/text_link"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Rate-limiting Security Text -->
        <TextView
            android:id="@+id/tvSecurityGateway"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:drawableStart="@drawable/ic_shield_lock"
            android:drawablePadding="6dp"
            android:text="@string/otp_security_gateway"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            app:drawableTint="@color/cyan_neon"
            app:layout_constraintTop_toBottomOf="@id/rowHelpdesk"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
