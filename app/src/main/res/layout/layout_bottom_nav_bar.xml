<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/globalBottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_alignParentBottom="true"
    android:background="#090E17"
    android:elevation="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <!-- Home Item -->
    <LinearLayout
        android:id="@+id/navItemHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Home"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Courses Item -->
    <LinearLayout
        android:id="@+id/navItemCourses"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/flNavCoursesGlow"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_active_glow">

            <ImageView
                android:id="@+id/ivNavCourses"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_graduation_cap"
                app:tint="@color/cyan_neon" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNavCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Courses"
            android:textColor="@color/cyan_neon"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Saved Item -->
    <LinearLayout
        android:id="@+id/navItemSaved"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavSaved"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvNavSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Saved"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Alerts Item -->
    <LinearLayout
        android:id="@+id/navItemAlerts"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavAlerts"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bell_notif"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvNavAlerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Alerts"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Profile Item -->
    <LinearLayout
        android:id="@+id/navItemProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_user"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Profile"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
