<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="17dp" /><gradient android:angle="0" android:startColor="#00E5FF" android:endColor="#0077FE" /><stroke android:width="1dp" android:color="#66E8FB" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="17dp" /><solid android:color="#1B3355" /><stroke android:width="1dp" android:color="#00E5FF" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="17dp" /><solid android:color="#111B2E" /><stroke android:width="1dp" android:color="#203F6B" /></shape>
    </item>
</selector>
